{
  "configurations": [
    {
      "inheritEnvironments": [ "msvc_x64_x64" ],
      "name": "x64-Debug",
      "includePath": [
        "${workspaceRoot}/include",
        "${workspaceRoot}/include/core",
        "${workspaceRoot}/include/platform",
        "${workspaceRoot}/include/platform/windows",
        "${workspaceRoot}/resources",
        "${env.INCLUDE}"
      ],
      "defines": [
        "UNICODE",
        "_UNICODE",
        "WIN32",
        "_WINDOWS"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x64"
    },
    {
      "inheritEnvironments": [ "msvc_x64_x64" ],
      "name": "x64-Release",
      "includePath": [
        "${workspaceRoot}/include",
        "${workspaceRoot}/include/core",
        "${workspaceRoot}/include/platform",
        "${workspaceRoot}/include/platform/windows",
        "${workspaceRoot}/resources",
        "${env.INCLUDE}"
      ],
      "defines": [
        "UNICODE",
        "_UNICODE",
        "WIN32",
        "_WINDOWS",
        "NDEBUG"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
