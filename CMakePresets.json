{
    "version": 8,
    "configurePresets": [
        {
            "name": "macOS-Clang",
            "displayName": "macOS Clang",
            "description": "macOS 默认 Clang 编译器",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "/usr/local/opt/qt@5"
            }
        },
        {
            "name": "Windows-MinGW",
            "displayName": "Windows MinGW",
            "description": "Windows MinGW 编译器",
            "generator": "MinGW Makefiles",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "d:/tools/mingw64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "d:/tools/mingw64/bin/g++.exe",
                "CMAKE_MAKE_PROGRAM": "d:/tools/mingw64/bin/mingw32-make.exe",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
